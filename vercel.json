{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "if [ ! -f frontend/package-lock.json ]; then cd ..; fi && cd frontend && npm ci --include=dev && npm run build",
  "functions": {
    "backend/main.py": {
      "includeFiles": "{data/*/area.txt,data/*/harmonized/monthly.parquet,data/*/processed/**/*.parquet,frontend/dist/**}",
      "excludeFiles": "{.vercel-stage/**,frontend/node_modules/**,frontend/tests/**,backend/tests/**,backend/scripts/**,notebooks/**,data/*/raw/**,data/demo/**,data/demo-recording/**,data/sri-lanka-2000-2025/**}"
    }
  }
}
